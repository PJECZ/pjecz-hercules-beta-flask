{% extends 'layouts/app.jinja2' %}
{% import 'macros/detail.jinja2' as detail %}
{% import 'macros/topbar.jinja2' as topbar %}

{% block title %}DGT Digitalización {{ dgt_digitalizacion.archivo_nombre }}{% endblock %}

{% block topbar_actions %}
    {% call topbar.page_buttons('DGT Digitalización ' + dgt_digitalizacion.archivo_nombre) %}
        {{ topbar.button_previous('DGT Digitalizaciones', url_for('dgt_digitalizaciones.list_active')) }}
    {% endcall %}
{% endblock %}

{% block content %}
    {% call detail.card(estatus=dgt_digitalizacion.estatus) %}
        <div class="row">
            {{ detail.label_value_big('Archivo', dgt_digitalizacion.archivo_nombre) }}
            {% if current_user.can_view('AUTORIDADES') %}
                {{ detail.label_value('Autoridad', dgt_digitalizacion.autoridad.clave, url_for('autoridades.detail', autoridad_id=dgt_digitalizacion.autoridad_id)) }}
            {% else %}
                {{ detail.label_value('Autoridad', dgt_digitalizacion.autoridad.clave) }}
            {% endif %}
            {% if current_user.can_view('DGT RUTAS') %}
                {{ detail.label_value('Ruta', dgt_digitalizacion.dgt_ruta.clave, url_for('dgt_rutas.detail', dgt_ruta_id=dgt_digitalizacion.dgt_ruta_id)) }}
            {% else %}
                {{ detail.label_value('Ruta', dgt_digitalizacion.dgt_ruta.clave) }}
            {% endif %}
            {{ detail.label_value('Expediente', dgt_digitalizacion.expediente) }}
            {{ detail.label_value('Año del expediente', dgt_digitalizacion.expediente_anio) }}
            {{ detail.label_value('Número del expediente', dgt_digitalizacion.expediente_num) }}
            {{ detail.label_value('Descripción', dgt_digitalizacion.descripcion) }}
            {{ detail.label_value('URL del archivo', dgt_digitalizacion.archivo_url) }}
            {{ detail.label_value('MD5', dgt_digitalizacion.archivo_md5) }}
            {{ detail.label_value('CRC32C', dgt_digitalizacion.archivo_crc32c) }}
            {{ detail.label_value('Tamaño (bytes)', dgt_digitalizacion.archivo_tamano) }}
            {{ detail.label_value('Actualizado', dgt_digitalizacion.archivo_actualizado.strftime('%Y-%m-%d %H:%M') if dgt_digitalizacion.archivo_actualizado else '') }}
        </div>
    {% endcall %}
{% endblock %}
