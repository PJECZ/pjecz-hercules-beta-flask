{% extends 'layouts/app.jinja2' %}
{% import 'macros/list.jinja2' as list %}
{% import 'macros/topbar.jinja2' as topbar %}

{% block title %}{{ titulo }}{% endblock %}

{% block topbar_actions %}
    {% call topbar.page_buttons(titulo) %}
        {% if current_user.can_admin('APP APLICACIONES') %}
            {% if estatus == 'A' %}{{ topbar.button_list_inactive('Inactivos', url_for('app_aplicaciones.list_inactive')) }}{% endif %}
            {% if estatus == 'B' %}{{ topbar.button_list_active('Activos', url_for('app_aplicaciones.list_active')) }}{% endif %}
        {% endif %}
        {% if current_user.can_insert('APP APLICACIONES') %}
            {{ topbar.button_new('Nueva aplicación', url_for('app_aplicaciones.new')) }}
        {% endif %}
    {% endcall %}
{% endblock %}

{% block content %}
    {% call list.card() %}
        <!-- Filtros App Aplicaciones -->
        <div class="row">
            <div class="col">
                <form class="row g-1 mb-3" id="filtradorForm" onsubmit="filtrosAppAplicaciones.buscar(); return false;">
                    <div class="col-2">
                        <div class="form-floating">
                            <input id="filtroAppAplicacionClave" type="text" class="form-control" aria-label="Clave" style="text-transform: uppercase;">
                            <label for="filtroAppAplicacionClave">Clave</label>
                        </div>
                    </div>
                    <div class="col-4">
                        <div class="form-floating">
                            <input id="filtroAppAplicacionDescripcion" type="text" class="form-control" aria-label="Descripción" style="text-transform: uppercase;">
                            <label for="filtroAppAplicacionDescripcion">Descripción</label>
                        </div>
                    </div>
                    <div class="col-6 text-end">
                        <button title="Buscar" class="btn btn-primary btn-lg" onclick="filtrosAppAplicaciones.buscar(); return false;" id="button-buscar"><span class="mdi mdi-magnify"></span></button>
                        <button title="Limpiar" class="btn btn-warning btn-lg" type="reset" onclick="filtrosAppAplicaciones.limpiar();" id="button-limpiar"><span class="mdi mdi-broom"></span></button>
                    </div>
                </form>
            </div>
        </div>
        <!-- Datatable App Aplicaciones -->
        <table id="app_aplicaciones_datatable" class="table {% if estatus == 'B'%}table-dark{% endif %} display nowrap" style="width:100%">
            <thead>
                <tr>
                    <th>Clave</th>
                    <th>Descripción</th>
                    <th>Cuota diaria</th>
                    <th>Cuota por hora</th>
                    <th>API key</th>
                    <th>Expiración</th>
                </tr>
            </thead>
        </table>
    {% endcall %}
{% endblock %}

{% block custom_javascript %}
    <script src="/static/js/datatables-constructor.js"></script>
    <script src="/static/js/datatables-filtros.js"></script>
    <script>
        // DataTable App Aplicaciones
        const constructorDataTable = new ConfigDataTable( '{{ csrf_token() }}' );
        let configDTAppAplicaciones = constructorDataTable.config();
        configDTAppAplicaciones['ajax']['url'] = "{{ url_for('app_aplicaciones.datatable_json') }}";
        configDTAppAplicaciones['ajax']['data'] = {{ filtros }};
        configDTAppAplicaciones['columns'] = [
            { data: 'detalle' },
            { data: 'descripcion' },
            { data: 'cuota_diaria' },
            { data: 'cuota_por_hora' },
            { data: 'api_key_oculta' },
            { data: 'expiracion' }
        ];
        configDTAppAplicaciones['columnDefs'] = [
            {
                targets: 0, // detalle
                data: null,
                render: function(data, type, row, meta) {
                    return '<a href="' + data.url + '">' + data.clave + '</a>';
                }
            }
        ];
        // Filtros App Aplicaciones
        const filtrosAppAplicaciones = new FiltrosDataTable('#app_aplicaciones_datatable', configDTAppAplicaciones);
        filtrosAppAplicaciones.agregarInput('filtroAppAplicacionClave', 'clave');
        filtrosAppAplicaciones.agregarInput('filtroAppAplicacionDescripcion', 'descripcion');
        filtrosAppAplicaciones.precargar();
    </script>
{% endblock %}
