{% extends 'layouts/app.jinja2' %}
{% import 'macros/form.jinja2' as f with context %}
{% import 'macros/topbar.jinja2' as topbar %}

{% block title %}Editar aplicación {{ app_aplicacion.clave }}{% endblock %}

{% block topbar_actions %}
    {{ topbar.page('Editar aplicación ' + app_aplicacion.clave) }}
{% endblock %}

{% block content %}
    {% call f.card() %}
        {% set form_kwargs = {'app_aplicacion_id': app_aplicacion.id} %}
        {% call f.form_tag('app_aplicaciones.edit', fid='app_aplicacion_form', **form_kwargs) %}
            {% call f.form_group(form.clave) %}{% endcall %}
            {% call f.form_group(form.descripcion) %}{% endcall %}
            {% call f.form_group(form.cuota_diaria) %}{% endcall %}
            {% call f.form_group(form.cuota_por_hora) %}{% endcall %}
            {% call f.form_group(form.guardar) %}{% endcall %}
        {% endcall %}
    {% endcall %}
{% endblock %}
