{% extends 'layouts/app.jinja2' %}
{% import 'macros/form.jinja2' as f with context %}
{% import 'macros/topbar.jinja2' as topbar %}

{% block title %}{{ titulo }}{% endblock %}

{% block topbar_actions %}
    {{ topbar.page(titulo) }}
{% endblock %}

{% block content %}
    {% call f.card() %}
        {% set form_kwargs = {'app_aplicacion_id': app_aplicacion.id} %}
        {% call f.form_tag('app_aplicaciones_roles.new_with_app_aplicacion', fid='app_aplicacion_rol_form', **form_kwargs) %}
            {% call f.form_group(form.app_aplicacion_clave, readonly=true) %}{% endcall %}
            {% call f.form_group(form.rol) %}{% endcall %}
            {% call f.form_group(form.nivel) %}{% endcall %}
            {% call f.form_group(form.guardar) %}{% endcall %}
        {% endcall %}
        <div class="form-text">Si la aplicación ya tiene ese rol, se actualiza su nivel y se reactiva.</div>
    {% endcall %}
{% endblock %}
