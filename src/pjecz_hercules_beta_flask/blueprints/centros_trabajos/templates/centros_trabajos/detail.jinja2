{% extends 'layouts/app.jinja2' %}
{% import 'macros/detail.jinja2' as detail %}
{% import 'macros/modals.jinja2' as modals %}
{% import 'macros/topbar.jinja2' as topbar %}

{% block title %}Centro de Trabajo {{ centro_trabajo.clave }}{% endblock %}

{% block topbar_actions %}
    {% call topbar.page_buttons('Centro de Trabajo ' + centro_trabajo.clave) %}
        {{ topbar.button_previous('Centros de Trabajo', url_for('centros_trabajos.list_active')) }}
        {% if current_user.can_edit('CENTROS TRABAJOS') %}
            {{ topbar.button_edit('Editar', url_for('centros_trabajos.edit', centro_trabajo_id=centro_trabajo.id)) }}
        {% endif %}
        {% if current_user.can_admin('CENTROS TRABAJOS') %}
            {% if centro_trabajo.estatus == 'A' %}{{ topbar.button_delete('Eliminar', url_for('centros_trabajos.delete', centro_trabajo_id=centro_trabajo.id)) }}{% endif %}
            {% if centro_trabajo.estatus == 'B' %}{{ topbar.button_recover('Recuperar', url_for('centros_trabajos.recover', centro_trabajo_id=centro_trabajo.id)) }}{% endif %}
        {% endif %}
    {% endcall %}
{% endblock %}

{% block content %}
    {% call detail.card(estatus=centro_trabajo.estatus) %}
        {{ detail.label_value_big('Clave', centro_trabajo.clave) }}
        {{ detail.label_value('Nombre', centro_trabajo.nombre) }}
        {% if current_user.can_view('DISTRITOS') %}
            {{ detail.label_value('Distrito', centro_trabajo.distrito.nombre, url_for('distritos.detail', distrito_id=centro_trabajo.distrito_id)) }}
        {% else %}
            {{ detail.label_value('Distrito', centro_trabajo.distrito.nombre) }}
        {% endif %}
        {% if current_user.can_view('DOMICILIOS') %}
            {{ detail.label_value('Edificio', centro_trabajo.domicilio.edificio, url_for('domicilios.detail', domicilio_id=centro_trabajo.domicilio_id)) }}
        {% else %}
            {{ detail.label_value('Edificio', centro_trabajo.domicilio.edificio) }}
        {% endif %}
        {{ detail.label_value('Teléfono', centro_trabajo.telefono) }}
    {% endcall %}
    {% if current_user.can_view('FUNCIONARIOS') and centro_trabajo.estatus == 'A' %}
        {% call detail.card('Funcionarios') %}
            <!-- Datatable Funcionarios -->
            <table id="funcionarios_datatable" class="table display nowrap" style="width:100%">
                <thead>
                    <tr>
                        <th>CURP</th>
                        <th>Nombre</th>
                        <th>Puesto</th>
                        <th>e-mail</th>
                        <th><span title="En funciones">En F.</span></th>
                        <th><span title="En funciones">En S.</span></th>
                    </tr>
                </thead>
            </table>
        {% endcall %}
    {% endif %}
{% endblock %}

{% block custom_javascript %}
    {% if current_user.can_admin('CENTROS TRABAJOS') %}
        {% if centro_trabajo.estatus == 'A' %}{{ modals.custom_javascript_delete('Eliminar', '¿Eliminar a ' + centro_trabajo.clave + '?') }}{% endif %}
        {% if centro_trabajo.estatus == 'B' %}{{ modals.custom_javascript_recover('Recuperar', '¿Recuperar a ' + centro_trabajo.clave + '?') }}{% endif %}
    {% endif %}
    {% if current_user.can_view('FUNCIONARIOS') and centro_trabajo.estatus == 'A' %}
        <script src="/static/js/datatables-constructor.js"></script>
        <script src="/static/js/datatables-filtros.js"></script>
        <script>
            // DataTable Funcionarios
            const constructorDataTable = new ConfigDataTable( '{{ csrf_token() }}' );
            let configDTFuncionarios = constructorDataTable.config();
            configDTFuncionarios['ajax']['url'] = "{{ url_for('funcionarios.datatable_json') }}";
            configDTFuncionarios['ajax']['data'] = { 'estatus': "A", 'centro_trabajo_id': {{ centro_trabajo.id }} };
            configDTFuncionarios['columns'] = [
                { data: 'detalle' },
                { data: 'nombre' },
                { data: 'puesto' },
                { data: 'email' },
                { data: 'en_funciones' },
                { data: 'en_soportes' }
            ];
            configDTFuncionarios['columnDefs'] = [
                {
                    targets: 0, // detalle
                    data: null,
                    render: function(data, type, row, meta) {
                        text = data.curp.substring(0, 4) + '…';
                        span_tag = '<span title="' + data.curp + '">' + text + '</span>';
                        return '<a href="' + data.url + '">' + span_tag + '</a>';
                    }
                },
                {
                    targets: [1, 2], // nombre, puesto
                    data: null,
                    render: function(data, type, row, meta) {
                        return (data.length > 32 ? data.substring(0, 32) + '…' : data);
                    }
                },
                {
                    targets: [4, 5], // en_funciones, en_soportes
                    data: null,
                    render: function(data, type, row, meta) {
                        if (data) { return 'SI'; } else { return ''; }
                    }
                }
            ];
            // Filtros Funcionarios
            const filtrosFuncionarios = new FiltrosDataTable('#funcionarios_datatable', configDTFuncionarios);
            filtrosFuncionarios.agregarInput('filtroFuncionarioCurp', 'curp');
            filtrosFuncionarios.agregarInput('filtroFuncionarioNombres', 'nombres');
            filtrosFuncionarios.agregarInput('filtroFuncionarioApellidoPaterno', 'apellido_paterno');
            filtrosFuncionarios.agregarInput('filtroFuncionarioPuesto', 'puesto');
            filtrosFuncionarios.precargar();
        </script>
    {% endif %}
{% endblock %}
