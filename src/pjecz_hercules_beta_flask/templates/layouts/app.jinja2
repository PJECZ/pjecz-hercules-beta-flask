{% extends 'layouts/base.jinja2' %}
{% import 'macros/flash.jinja2' as flash with context %}
{% import 'macros/navigation.jinja2' as navigation %}

{% block template_head %}
    <!-- Google Fonts Roboto -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Roboto:wght@400;500;700&display=swap">
    <!-- Datatables.net -->
    <link rel="stylesheet" type="text/css" href="https://cdn.datatables.net/2.3.4/css/dataTables.bootstrap5.css">
    <!-- CSS Dashboard -->
    <link rel="stylesheet" type="text/css" href="{{ url_for('static', filename='css/dashboard.css') }}">
    <link rel="stylesheet" type="text/css" href="{{ url_for('static', filename='css/colors.css') }}">
    <!-- Restaurar el estado colapsado del menu antes de pintar para evitar parpadeo -->
    <script>
        try {
            if (localStorage.getItem('sidebarCollapsed') === '1') {
                document.documentElement.classList.add('sidebar-collapsed');
            }
        } catch (e) {}
    </script>
    <!-- CSRF token -->
    <meta name="csrf-token" content="{{ csrf_token() }}">
{% endblock %}

{% block main %}
    <div class="d-flex flex-column min-vh-100">
    <!-- Dashboard search -->
    <header class="navbar sticky-top bg-dark flex-md-nowrap p-0 shadow" data-bs-theme="dark">
        <a class="navbar-brand col-md-3 col-lg-2 me-0 px-3 fs-6 text-white" href="{{ url_for('sistemas.start') }}">
        <img class="mx-2" src="https://storage.googleapis.com/pjecz-informatica/static/images/logo.png" alt="PJECZ"  width="30" height="30">
            Plataforma Web BETA
        </a>
        <ul class="navbar-nav flex-row d-md-none">
            <li class="nav-item text-nowrap">
                <button class="nav-link px-3 text-white" type="button" data-bs-toggle="collapse" data-bs-target="#navbarSearch" aria-controls="navbarSearch" aria-expanded="false" aria-label="Toggle search">
                    <svg class="bi" aria-hidden="true"><use xlink:href="#search"></use></svg>
                </button>
            </li>
            <li class="nav-item text-nowrap">
                <button class="nav-link px-3 text-white" type="button" data-bs-toggle="offcanvas" data-bs-target="#sidebarMenu" aria-controls="sidebarMenu" aria-expanded="false" aria-label="Toggle navigation">
                    <svg class="bi" aria-hidden="true"><use xlink:href="#list"></use></svg>
                </button>
            </li>
        </ul>
        <div id="navbarSearch" class="navbar-search w-100 collapse">
            <input class="form-control w-100 rounded-0 border-0" type="text" placeholder="Search" aria-label="Search">
        </div>
    </header>
    <!-- Dashboard row -->
    <div class="container-fluid flex-grow-1 d-flex flex-column" id="work">
        <div class="row flex-grow-1" id="work-row">
            <!-- Dashboard sidebar -->
            <div class="sidebar border border-right col-md-3 col-lg-2 p-0 bg-dark">
                <!-- Boton para colapsar/expandir el menu (solo en pantallas medianas o mayores) -->
                <button type="button" class="nav-link sidebar-toggle d-none d-md-flex align-items-center gap-2 w-100 mt-2" id="sidebarToggle" title="Colapsar/expandir menú" aria-label="Colapsar/expandir menú">
                    <span class="mdi mdi-chevron-double-left"></span> <span class="sidebar-label">Colapsar menú</span>
                </button>
                <div class="offcanvas-md offcanvas-end bg-dark" tabindex="-1" id="sidebarMenu" aria-labelledby="sidebarMenuLabel">
                    <div class="offcanvas-header">
                        <h5 class="offcanvas-title" id="sidebarMenuLabel">
                            Plataforma Web BETA
                        </h5>
                        <button type="button" class="btn-close" data-bs-dismiss="offcanvas" data-bs-target="#sidebarMenu" aria-label="Close"></button>
                    </div>
                    <!-- Dashboard main menu -->
                    {% call navigation.menu() %}
                        {{ navigation.menu_option('Inicio', url_for('sistemas.start'), 'mdi mdi-home') }}
                        {% for modulo in current_user.modulos_menu_principal %}
                            {{ navigation.menu_option(modulo.nombre_corto, modulo.ruta, modulo.icono_nuevo) }}
                        {% endfor %}
                    {% endcall %}
                </div>
            </div>
            <!-- Dashboard main -->
            <main class="col-md-9 ms-sm-auto col-lg-10 px-md-4" id="work-row-main">
                {% block topbar_actions %}{% endblock %}
                {{ flash.render() }}
                {% block content %}{% endblock %}
            </main>
        </div>
    </div>
    </div>
{% endblock %}

{% block template_javascript %}
    <!-- Datatables.net -->
    <script type="text/javascript" src="https://cdn.datatables.net/2.3.4/js/dataTables.js"></script>
    <script type="text/javascript" src="https://cdn.datatables.net/2.3.4/js/dataTables.bootstrap5.js"></script>
    <!-- Moment.js -->
    <script type="text/javascript" src="https://cdnjs.cloudflare.com/ajax/libs/moment.js/2.30.1/moment.min.js"></script>
    <script type="text/javascript" src="https://cdnjs.cloudflare.com/ajax/libs/moment.js/2.30.1/locale/es-mx.min.js"></script>
    <!-- Colapsar/expandir menu principal -->
    <script>
        document.getElementById('sidebarToggle').addEventListener('click', function () {
            const collapsed = document.documentElement.classList.toggle('sidebar-collapsed');
            try {
                localStorage.setItem('sidebarCollapsed', collapsed ? '1' : '0');
            } catch (e) {}
        });
    </script>
{% endblock %}
