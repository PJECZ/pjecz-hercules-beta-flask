{# Dashboard navigation #}

{%- macro menu() -%}
    <div class="offcanvas-body d-md-flex flex-column p-0 pt-lg-3 overflow-y-auto">
        <ul class="nav flex-column">
            {{ caller() }}
        </ul>
        <hr class="my-3">
        <ul class="nav flex-column mb-auto">
            <li class="nav-item">
                <a class="nav-link d-flex align-items-center gap-2" href="{{ url_for('usuarios.profile') }}" title="Perfil">
                    <span class="mdi mdi-account"></span> <span class="sidebar-label">Perfil</span>
                </a>
            </li>
            <li class="nav-item">
                <a class="nav-link d-flex align-items-center gap-2" href="{{ url_for('usuarios.logout') }}" title="Salir">
                    <span class="mdi mdi-logout"></span> <span class="sidebar-label">Salir</span>
                </a>
            </li>
        </ul>
    </div>
{%- endmacro -%}

{%- macro menu_option(label, url, icon) -%}
    <li class="nav-item">
        <a class="nav-link d-flex align-items-center gap-2" href="{{ url }}" title="{{ label }}">
            <span class="{{ icon }}"></span> <span class="sidebar-label">{{ label }}</span>
        </a>
    </li>
{%- endmacro -%}
